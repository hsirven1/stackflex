# Production site URL (absolute). Required for OG tags, sitemap, share links, OAuth callbacks, MCP review URLs.
# Must be the canonical host with NO redirect. Live StackFlex redirects apex → www, so use:
NEXT_PUBLIC_SITE_URL=https://www.stackflex.app

# Contact email shown on /contact (optional; defaults to hello@stackflex.app).
# NEXT_PUBLIC_CONTACT_EMAIL=hello@stackflex.app

# Vercel Web Analytics page views load via <Analytics /> (no env required once enabled
# in the Vercel project dashboard). Custom funnel events need Pro+; leave unset on Hobby.
# NEXT_PUBLIC_VERCEL_ANALYTICS_EVENTS=1

# MCP portfolio drafting (single-user / private mode). See docs/MCP.md.
# Server-only secrets — never use NEXT_PUBLIC_ for these.
# Without MCP_PORTFOLIO_TOKEN, /api/mcp returns 503.
# MCP_PORTFOLIO_TOKEN=
# Required in production to sign private review URLs (falls back to STACKFLEX_OAUTH_SECRET locally):
# MCP_DRAFT_SECRET=

# LinkedIn OpenID Connect (optional — leave unset to keep LinkedIn import disabled).
# Create an app at https://www.linkedin.com/developers/
# Products: "Sign In with LinkedIn using OpenID Connect"
# Redirect URL: {NEXT_PUBLIC_SITE_URL}/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional override if the callback host differs from NEXT_PUBLIC_SITE_URL:
# LINKEDIN_REDIRECT_URI=https://stackflex.app/api/auth/linkedin/callback
# Optional dedicated cookie-signing secret (falls back to LINKEDIN_CLIENT_SECRET).
# Required in production whenever LinkedIn import is enabled:
# STACKFLEX_OAUTH_SECRET=

# Durable public profile photo storage is not configured in this MVP.
# Without object storage, share snapshots use initials / generic avatars.
# LinkedIn photos may appear as a local-only editor preview and are not embedded in share URLs.
